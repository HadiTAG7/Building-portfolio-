{
  "name": "portfolio-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "data:import": "python3 scripts/import_excel.py",
    "deploy": "NODE_USE_ENV_PROXY=1 node scripts/deploy.mjs",
    "test:rules": "firebase emulators:exec --project demo-portfolio --only firestore \"vitest run tests/firestore.rules.test.ts\""
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "next": "16.3.6",
    "quadprog": "^2.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "google-auth-library": "^11.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20.9"
  }
}
